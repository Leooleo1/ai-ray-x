{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "raiox",
  "version": "0.1.8",
  "identifier": "app.raiox.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Your AIs in each project, and where their tokens go",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../apps/web/dist/": "web/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzNURFNDAyRTEwN0QxRkUKUldUKzBRZmhBdVJkVTZWdFNjaGVkNzBPa2QxT1AxRXA2aHh0TDhya3ZjOEowNkd6OVJTZk9jYTMK",
      "endpoints": [
        "https://github.com/Leooleo1/ai-ray-x/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
